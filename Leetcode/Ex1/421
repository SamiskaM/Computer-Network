int findMaximumXOR(int* nums, int numsSize)
{
    int trie[6200000][2] = {0};
    int nodes = 1;
    int answer = 0;

    /* Build Trie */
    for (int i = 0; i < numsSize; i++)
    {
        int current = 0;

        for (int bit = 30; bit >= 0; bit--)
        {
            int b = (nums[i] >> bit) & 1;

            if (trie[current][b] == 0)
            {
                trie[current][b] = nodes;
                nodes++;
            }

            current = trie[current][b];
        }
    }

    /* Find maximum XOR */
    for (int i = 0; i < numsSize; i++)
    {
        int current = 0;
        int value = 0;

        for (int bit = 30; bit >= 0; bit--)
        {
            int b = (nums[i] >> bit) & 1;
            int opposite = 1 - b;

            if (trie[current][opposite] != 0)
            {
                value |= (1 << bit);
                current = trie[current][opposite];
            }
            else
            {
                current = trie[current][b];
            }
        }

        if (value > answer)
            answer = value;
    }

    return answer;
}
