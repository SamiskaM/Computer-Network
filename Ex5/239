int* maxSlidingWindow(int* nums, int numsSize, int k, int* returnSize) {
    if (numsSize == 0 || k == 0) {
        *returnSize = 0;
        return NULL;
    }
    int max_elements = numsSize - k + 1;
    int* result = (int*)malloc(max_elements * sizeof(int));
    int result_idx = 0;
    int* deque = (int*)malloc(numsSize * sizeof(int));
    int head = 0;
    int tail = 0;
    for (int i = 0; i < numsSize; i++) {
        if (head < tail && deque[head] < i - k + 1) {
            head++;
        }
        while (head < tail && nums[deque[tail - 1]] <= nums[i]) {
            tail--;
        }
        deque[tail++] = i;
        if (i >= k - 1) {
            result[result_idx++] = nums[deque[head]];
        }
    }
    free(deque);
    *returnSize = result_idx;
    return result;
}
